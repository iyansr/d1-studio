{
  "name": "@iyansr/d1-studio",
  "version": "0.0.0",
  "description": "Zero-config studio for Cloudflare D1, local or remote",
  "homepage": "https://github.com/iyansr/d1-studio#readme",
  "bugs": {
    "url": "https://github.com/iyansr/d1-studio/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyansr/d1-studio.git"
  },
  "bin": {
    "d1-studio": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.mjs",
    "build": "pnpm build:ui && pnpm build:cli",
    "build:ui": "pnpm --filter ui build",
    "build:cli": "tsup",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "format": "oxfmt && oxlint --fix",
    "check": "pnpm lint && pnpm format:check && pnpm test",
    "check:size": "node scripts/check-size.mjs",
    "fixtures": "node --experimental-strip-types test/fixtures/make.ts",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "version-packages": "changeset version && oxfmt",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@clack/prompts": "^1.8.1",
    "@hono/node-server": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "citty": "^0.2.2",
    "hono": "^4.13.9",
    "jsonc-parser": "^3.3.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "smol-toml": "^1.9.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.16"
  },
  "packageManager": "pnpm@12.4.2"
}
